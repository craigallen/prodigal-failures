# Environment variables for Prodigal Failures.
# Copy this file to .env.local and fill in real values:
#
#   cp .env.example .env.local
#
# In production (Vercel), set these in Project Settings → Environment Variables.

# Resend API key — used by the /api/contact route to send the contact form email.
# Create one in the Resend dashboard: https://resend.com → API Keys.
RESEND_API_KEY=
